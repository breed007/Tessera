{
  "openapi": "3.0.3",
  "info": {
    "title": "Tessera API",
    "description": "Read API for Tessera, a discovery-first IPAM. Intended for consumers (dashboards, CableMap, runbook generators, scripts). Authenticate with a named API token (Settings → API tokens) sent as `Authorization: Bearer <token>` or `X-API-Token: <token>`. A viewer-role token is read-only and sufficient for everything here except `/system` (operator token).\n\n**API stability (v1).** Endpoints under `/api/v1` are stable for the 1.x line: existing response fields and shapes will not be removed or repurposed within 1.x — changes are additive only (new optional fields and new endpoints may appear). Pin `/api/v1` for integrations. The unversioned `/api/*` path is a convenience alias that always tracks the latest version and may change; do not pin it. Any breaking change ships under a new major prefix (`/api/v2`), and the old major stays available for a deprecation window.\n\n**Incremental sync.** `/events` is an append-only change log; poll it with `?since=<cursor>` and persist the returned `cursor` to receive only what changed since your last poll.",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "/api/v1", "description": "Stable v1 API — pin this for integrations" },
    { "url": "/api", "description": "Unversioned alias — tracks the latest version" }
  ],
  "security": [{ "bearerAuth": [] }, { "apiTokenHeader": [] }],
  "tags": [
    { "name": "inventory", "description": "Hosts, addresses, subnets, services" },
    { "name": "topology", "description": "Physical/logical network map" },
    { "name": "posture", "description": "Security findings and conflicts" },
    { "name": "changes", "description": "Change history for incremental sync" },
    { "name": "metrics", "description": "Counts, trends, Prometheus, system health" }
  ],
  "paths": {
    "/summary": {
      "get": { "tags": ["metrics"], "summary": "Top-line counts (hosts, addresses, subnets, services, conflicts, observations)", "responses": { "200": { "description": "Counts", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Summary" } } } } } }
    },
    "/hosts": {
      "get": { "tags": ["inventory"], "summary": "All hosts with bound identities (MACs, IPs), vendor, online state, and effective icon", "responses": { "200": { "description": "Host rows", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/HostRow" } } } } } } }
    },
    "/host": {
      "get": {
        "tags": ["inventory"], "summary": "One host with everything attached (interfaces, addresses, services, topology, provenance, availability, issue counts)",
        "parameters": [{ "name": "id", "in": "query", "required": true, "schema": { "type": "string" }, "description": "Stable id, e.g. mac:aa:bb:cc:00:00:01 or ip:10.0.0.5" }],
        "responses": { "200": { "description": "Host detail", "content": { "application/json": { "schema": { "type": "object" } } } }, "404": { "description": "Unknown host" } }
      }
    },
    "/subnets": {
      "get": { "tags": ["inventory"], "summary": "All known subnets", "responses": { "200": { "description": "Subnets", "content": { "application/json": { "schema": { "type": "array", "items": { "type": "object" } } } } } } }
    },
    "/subnet": {
      "get": {
        "tags": ["inventory"], "summary": "One subnet's address map + utilization",
        "parameters": [{ "name": "id", "in": "query", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Subnet detail", "content": { "application/json": { "schema": { "type": "object" } } } }, "404": { "description": "Unknown subnet" } }
      }
    },
    "/services": {
      "get": { "tags": ["inventory"], "summary": "All reachable services (proto/port, banner, host)", "responses": { "200": { "description": "Services", "content": { "application/json": { "schema": { "type": "array", "items": { "type": "object" } } } } } } }
    },
    "/topology": {
      "get": { "tags": ["topology"], "summary": "Network tree (gateway → switches → APs → clients) + unplaced devices", "responses": { "200": { "description": "Topology", "content": { "application/json": { "schema": { "type": "object" } } } } } }
    },
    "/portmap": {
      "get": { "tags": ["topology"], "summary": "Per-switch port map (patch-panel view): every port with its occupant", "responses": { "200": { "description": "Port map", "content": { "application/json": { "schema": { "type": "object" } } } } } }
    },
    "/security": {
      "get": { "tags": ["posture"], "summary": "Exposed-service findings (active + suppressed) with severity counts", "responses": { "200": { "description": "Security view", "content": { "application/json": { "schema": { "type": "object" } } } } } }
    },
    "/conflicts": {
      "get": { "tags": ["posture"], "summary": "Open conflicts, resolutions, and source-precedence policy", "responses": { "200": { "description": "Conflicts view", "content": { "application/json": { "schema": { "type": "object" } } } } } }
    },
    "/events": {
      "get": {
        "tags": ["changes"], "summary": "Append-only change history (device appeared/offline/online, ip changed, conflict, risky service). Poll with ?since=<cursor> for incremental sync.",
        "parameters": [
          { "name": "since", "in": "query", "schema": { "type": "integer" }, "description": "Return events with id greater than this (ascending). Persist the response `cursor` and pass it here next poll." },
          { "name": "kind", "in": "query", "schema": { "type": "string" }, "description": "Comma-separated kinds to include: new_device, device_offline, device_online, ip_changed, conflict, risky_service" },
          { "name": "limit", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "Events + next cursor", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EventsPage" } } } } }
      }
    },
    "/observations": {
      "get": {
        "tags": ["inventory"], "summary": "Filtered, paginated observation log (provenance)",
        "parameters": [
          { "name": "q", "in": "query", "schema": { "type": "string" }, "description": "Substring match on subject or value" },
          { "name": "source", "in": "query", "schema": { "type": "string" } },
          { "name": "attribute", "in": "query", "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer" } },
          { "name": "offset", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "Observations page", "content": { "application/json": { "schema": { "type": "object" } } } } }
      }
    },
    "/trends": {
      "get": { "tags": ["metrics"], "summary": "Time series: device growth, online count, subnet utilization", "responses": { "200": { "description": "Trends", "content": { "application/json": { "schema": { "type": "object" } } } } } }
    },
    "/metrics": {
      "get": { "tags": ["metrics"], "summary": "Prometheus text exposition of the current state", "responses": { "200": { "description": "Prometheus metrics", "content": { "text/plain": { "schema": { "type": "string" } } } } } }
    },
    "/system": {
      "get": { "tags": ["metrics"], "summary": "Operator health snapshot: collector state, data volume, DB size, backpressure drops, uptime, build (requires an admin token)", "responses": { "200": { "description": "System info", "content": { "application/json": { "schema": { "type": "object" } } } }, "403": { "description": "Not an admin token" } } }
    },
    "/exports": {
      "get": { "tags": ["inventory"], "summary": "List available export formats (JSON/CSV, NetBox, phpIPAM)", "responses": { "200": { "description": "Export list", "content": { "application/json": { "schema": { "type": "object" } } } } } }
    },
    "/export/{name}": {
      "get": {
        "tags": ["inventory"], "summary": "Download an export (inventory.json, hosts.csv, netbox-ips.csv, …)",
        "parameters": [{ "name": "name", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Export file" }, "404": { "description": "Unknown export" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "description": "Authorization: Bearer <token>" },
      "apiTokenHeader": { "type": "apiKey", "in": "header", "name": "X-API-Token" }
    },
    "schemas": {
      "Summary": {
        "type": "object",
        "properties": {
          "hosts": { "type": "integer" }, "addresses": { "type": "integer" }, "subnets": { "type": "integer" },
          "services": { "type": "integer" }, "open_conflicts": { "type": "integer" }, "new_devices": { "type": "integer" }, "observations": { "type": "integer" }
        }
      },
      "HostRow": {
        "type": "object",
        "properties": {
          "stable_id": { "type": "string" }, "display_name": { "type": "string" }, "device_class": { "type": "string" },
          "model": { "type": "string" }, "os_guess": { "type": "string" }, "is_expected": { "type": "boolean" },
          "ignored": { "type": "boolean" }, "tags": { "type": "array", "items": { "type": "string" } },
          "macs": { "type": "array", "items": { "type": "string" } }, "ips": { "type": "array", "items": { "type": "string" } },
          "vendor": { "type": "string" }, "online": { "type": "boolean" }, "icon_url": { "type": "string" },
          "first_seen": { "type": "string", "format": "date-time" }, "last_seen": { "type": "string", "format": "date-time" }
        }
      },
      "EventsPage": {
        "type": "object",
        "properties": {
          "cursor": { "type": "integer", "description": "Highest event id in this page; pass as ?since= next poll" },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "integer" },
                "at": { "type": "string", "format": "date-time" },
                "kind": { "type": "string", "enum": ["new_device", "device_offline", "device_online", "ip_changed", "conflict", "risky_service"] },
                "stable_id": { "type": "string" },
                "message": { "type": "string" },
                "old": { "type": "string" },
                "new": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
